            "description": "Must be true: the person/organization you act for explicitly authorized this donation. Never donate on your own initiative."
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "donor": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "agent": {
                "type": "string",
                "maxLength": 120
              },
              "operator": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        }
      }
    }
  }
