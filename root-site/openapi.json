            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_payment",
              "payment_review",
              "paid",
              "fulfilling",
              "completed",
              "cancelled",
              "expired",
              "failed"
            ]
          },
          "total_usd": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "payment_rail": {
