                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          },
          "details": {
            "type": "object",
            "properties": {
              "store_name": {
                "type": "string"
              },
              "contact_email": {
                "type": "string"
              },
              "website_url": {
                "type": "string"
              },
              "discord_url": {
                "type": "string"
              }
            }
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
