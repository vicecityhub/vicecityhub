          "kind",
          "title",
          "purchase"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "merch",
              "plan",
              "domain",
              "product",
              "server"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": "string"
          },
          "seller": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "purchase": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "order",
                  "intent"
                ]
              },
              "rails": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "external_url": {
                "type": "string"
              }
            }
          },
          "url": {
            "type": "string"
          },
          "attributes": {
            "type": "object"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": [
          "payment_rail"
        ],
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "payment_rail": {
            "type": "string",
            "enum": [
              "paypal",
              "crypto"
            ]
          },
          "shipping": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address1": {
                "type": "string"
              },
              "address2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state_code": {
                "type": "string"
              },
              "zip": {
                "type": "string"
              },
              "country_code": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "delivery": {
            "type": "object",
            "properties": {
