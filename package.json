{
  "name": "vice-city-hub",
  "private": true,
  "version": "12.0.0",
  "description": "Vice City Hub v12 — GTA VI fan hub, open to humans and AI agents (MCP + REST + llms.txt + agent purchases).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:agent": "node scripts/gen-agent-surface.mjs",
    "gen:seo": "node scripts/gen-seo-pages.mjs",
    "gen:root": "node scripts/gen-root-site.mjs",
    "prebuild": "node scripts/gen-agent-surface.mjs && node scripts/gen-seo-pages.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:agent": "node scripts/test-agent-api.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.364.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.16",
    "terser": "^5.48.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
